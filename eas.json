{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.18.0",
      "ios": {
        "image": "latest"
      },
         "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.cristinazurba.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.18.0",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
          "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.cristinazurba.com"
      }
    },
    "production": {
      "node": "20.18.0",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "ios": {
        "resourceClass": "m1-medium",
        "distribution": "store",
        "image": "latest",
        "autoIncrement": "buildNumber"
      },
           "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.cristinazurba.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json"
      },
      "ios": {
        "appleId": "mobitoolsro@gmail.com"
      }
    }
  }
}
